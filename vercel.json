{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{app.py,ingest_cv.py,test*.py,docs/**,public/**,summary.txt,README.md,DEPLOY.md,render.yaml}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://zyadwaled780-cmd.github.io http://127.0.0.1:* http://localhost:*"
        }
      ]
    }
  ]
}
